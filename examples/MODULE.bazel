module(
    name = "examples",
    bazel_compatibility = [">=7.1.0"],
)

bazel_dep(name = "download_archives", version = "", dev_dependency = True)
bazel_dep(name = "bazel_skylib", version = "1.7.1", dev_dependency = True)
bazel_dep(name = "version_utils", version = "0.1.0", dev_dependency = True)

local_path_override(
    module_name = "download_archives",
    path = "..",
)

download_archives = use_repo_rule("@download_archives//download/archives:defs.bzl", "download_archives")

download_archives(
    name = "wget_src",
    index = "//third-party/wget:repo.json",
    lazy = False,
    patches = {
        "//third-party/wget/patches:0001-1.24.5-test-patch.patch": ">=1.24.5/*",
    },
    strict_integrity = False,
)

download_archives(
    name = "pg_src",
    index = "//third-party/postgres:repo.json",
    lazy = False,
    patches = {
        "//third-party/postgres/patches:0001-16.0-fix-pgflex.patch": "<17.0",
    },
    version_scheme = "pgver",
    versions = ["16.0"],
)

# lazy mode: index repo + per-version download repo (manual wiring)
download_archives(
    name = "wget_lazy",
    index = "//third-party/wget:repo.json",
    lazy = True,
    strict_integrity = False,
    versions = ["1.24.5"],
)

download_archives(
    name = "wget_lazy-1.24.5",
    index = "//third-party/wget:repo.json",
    lazy = False,
    strict_integrity = False,
    versions = ["1.24.5"],
)

# module extension: creates index + per-version repos automatically
download = use_extension(
    "@download_archives//download/archives:extensions.bzl",
    "download_archives",
)
download.archives(
    name = "wget_ext",
    index = "//third-party/wget:repo.json",
    strict_integrity = False,
    versions = ["1.24.5"],
)
use_repo(download, "wget_ext")

# matrix: one archive per (triple, component) combination, partitioned by
# triple so that each triple is a usable toolchain prefix of its own
download.archives(
    name = "rust_toolchain",
    index = "//third-party/rust:repo.json",
)
use_repo(download, "rust_toolchain")
