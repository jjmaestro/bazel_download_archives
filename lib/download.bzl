"""Shared download helpers for archive repository rules."""

load("//lib:utils.bzl", Utils = "utils")

_SOURCE_BZL = '''\
"""Generated by download_archives. DO NOT EDIT."""

SOURCE = "{source}"
URL = "{url}"
'''

_BUILD_PATCHES = '''\
"""Generated by download_archives. DO NOT EDIT."""

package(default_visibility = ["//visibility:public"])

exports_files(glob(
    [
        "*.patch",
        "*.diff",
    ],
    allow_empty = True,
))
'''

def _contexts(repo):
    """The repo's contexts, one per matrix combination (one without a matrix)."""
    contexts = getattr(repo, "contexts", None)

    if contexts != None:
        return contexts

    return [struct(output = "", context = repo.context)]

def _check_strict_integrity(repos, version, _fail):
    """Fail if repos for a version have different integrity hashes."""
    contexts = [_contexts(repo) for repo in repos]

    # With a matrix, the sources have to agree combination by combination, so
    # there's one comparison per combination and not just one for the version
    combos = max([len(c) for c in contexts]) if contexts else 0

    for combo in range(combos):
        integrities = {
            repo_contexts[combo].context["integrity"]: None
            for repo_contexts in contexts
            if combo < len(repo_contexts) and
               repo_contexts[combo].context.get("integrity", None) != None
        }

        if len(integrities) >= 2:
            msg = "Version {} has {} different integrities "
            msg += "while strict_integrity=True"
            return _fail(msg.format(version, len(integrities)))

    return None

def _make_download_args(repo_path, repo_context, _print = print):
    """Build rctx.download_and_extract kwargs from a materialized repo context."""

    # https://bazel.build/rules/lib/builtins/repository_ctx#download_and_extract
    allowed = [
        "url",
        "sha256",
        "type",
        "strip_prefix",
        "canonical_id",
        "auth",
        "headers",
        "integrity",
        "rename_files",
    ]

    # output and allow_fail cannot be exposed to the users: output is fixed and
    # allow_fail has to be True to attempt the downloads from the different
    # sources
    ignored = ["output", "allow_fail"]

    args = {}

    for arg in allowed + ignored:
        if arg not in repo_context:
            continue

        if arg in ignored:
            msg = "{}: ignoring '{}' in context"
            _print(msg.format(repo_path, arg))
            continue

        if (
            arg == "strip_prefix" and
            native.bazel_version and native.bazel_version < "8.0.0"
        ):
            # https://github.com/bazelbuild/bazel/issues/24034
            args["stripPrefix"] = repo_context[arg]
        else:
            args[arg] = repo_context[arg]

    # Bazel download expects either 'sha256' or 'integrity' but not both. And,
    # even when we've validated the index to prevent the users from using both,
    # we are actually adding both to the context, so we need to remove it here
    # to have compatible arguments for the download method
    if "sha256" in args and "integrity" in args:
        args.pop("sha256")

    return args

def _apply_patch(rctx, version, source, patch):
    """Apply a patch with path rewriting for nested extraction."""
    patch_content = rctx.read(patch)

    # The patches are generated from the root of the repo but the archives are
    # extracted into /version/source so the patch has to be modified to match
    # the new path in the Bazel repo
    for letter in ("a", "b"):
        for prefix in ("git %s/", "--- %s/", "+++ %s/"):
            patch_content = patch_content.replace(
                prefix % letter,
                (prefix % letter) + "%s/%s/" % (version, source),
            )

    patch_path = "patches/%s/%s" % (version, source)
    rctx.file("%s/BUILD.bazel" % patch_path, _BUILD_PATCHES, executable = False)

    patch_file = "%s/%s" % (patch_path, patch.name)
    rctx.file(patch_file, patch_content, executable = False)

    rctx.patch(patch_file, strip = 1)

def _try_sources(
        rctx,
        repo_name,
        version,
        repos,
        patches = {},
        spec_syntax = "",
        version_scheme = "",
        strict_integrity = False,
        _print = print,
        _fail = fail):
    """Try downloading a version from each source in order.

    Handles the full download-level workflow: strict integrity check, download,
    integrity warning, source.bzl generation, and patch application. Archives
    are extracted to `version/source/` and patches are rewritten to match the
    nested layout.

    Args:
        rctx: Repository context.
        repo_name: Name for log/error messages.
        version: Version being downloaded.
        repos: List of repo struct sources to try, in order.
        patches: label_keyed_string_dict of patch labels to version specs.
            Matching is computed per-source; only the winning source's patches
            are applied.
        spec_syntax: Spec syntax for patch matching.
        version_scheme: Version scheme for patch matching.
        strict_integrity: If True, fail when sources have different integrity
            hashes.
        _print: Print function for warnings.
        _fail: Fail function for errors.

    Returns:
        struct(source, url, integrity, sha256, output, patches) on first
        success, or None if all sources failed.
    """
    if strict_integrity:
        _check_strict_integrity(repos, version, _fail)

    for repo in repos:
        repo_path = "%s/%s" % (version, repo.source)

        # A source provides every combination of the index `matrix` (just one
        # when there is no matrix). Combinations whose `output` renders the
        # same subpath merge into one extracted tree; the rest partition it.
        # A source counts as usable only if ALL of its combinations download,
        # so a partial mirror falls through to the next source rather than
        # leaving a half-materialized tree.
        result = None
        results = []

        for combo in _contexts(repo):
            combo_path = "/".join([repo_path, combo.output]) if combo.output else repo_path
            download_args = _make_download_args(combo_path, combo.context, _print)

            result = rctx.download_and_extract(
                output = combo_path,
                allow_fail = True,
                **download_args
            )

            if not result.success:
                break

            results.append(struct(
                path = combo_path,
                output = combo.output,
                context = combo.context,
                result = result,
            ))

        if not result or not result.success:
            continue

        for downloaded in results:
            if "integrity" in downloaded.context:
                continue

            msg = "{}/{}: WARNING: integrity missing. "
            msg += "Please add the integrity / sha256 to the index: {} / {}"
            _print(msg.format(
                repo_name,
                downloaded.path,
                downloaded.result.integrity,
                downloaded.result.sha256,
            ))

        rctx.file(
            "%s/source.bzl" % version,
            _SOURCE_BZL.format(source = repo.source, url = repo.context["url"]),
            executable = False,
        )

        matched_patches = Utils.matching_patches(
            patches,
            version,
            repo.source,
            spec_syntax,
            version_scheme,
        )

        for patch in matched_patches:
            _apply_patch(rctx, version, repo.source, patch)

        return struct(
            source = repo.source,
            url = repo.context["url"],
            integrity = result.integrity,
            sha256 = result.sha256,
            output = repo_path,
            outputs = Utils.dedupe([d.output for d in results if d.output]),
            patches = matched_patches,
        )

    return None

download = struct(
    check_strict_integrity = _check_strict_integrity,
    make_download_args = _make_download_args,
    apply_patch = _apply_patch,
    try_sources = _try_sources,
)
