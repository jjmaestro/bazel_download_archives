load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "dir.bzl",
    "download.bzl",
    "index.bzl",
    "integrity.bzl",
    "matrix.bzl",
    "schema.bzl",
    "utils.bzl",
])

bzl_library(
    name = "dir",
    srcs = ["dir.bzl"],
)

bzl_library(
    name = "download",
    srcs = ["download.bzl"],
    deps = [
        ":utils",
    ],
)

bzl_library(
    name = "utils",
    srcs = ["utils.bzl"],
    deps = [
        "@version_utils//spec",
        "@version_utils//version",
    ],
)

bzl_library(
    name = "integrity",
    srcs = ["integrity.bzl"],
    deps = [
        "@aspect_bazel_lib//lib:base64",
        "@aspect_bazel_lib//lib:strings",
    ],
)

bzl_library(
    name = "matrix",
    srcs = ["matrix.bzl"],
)

bzl_library(
    name = "schema",
    srcs = ["schema.bzl"],
    deps = [
        ":integrity",
        ":matrix",
    ],
)

bzl_library(
    name = "index",
    srcs = ["index.bzl"],
    deps = [
        ":integrity",
        ":matrix",
        ":schema",
        ":utils",
    ],
)
